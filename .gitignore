# Folder contents are ignored; the .gitkeep files keep the folders in the repo

# Private files: the AniList user ID -> anonymised ID map (and any data with real usernames)
data/private/*
!data/private/.gitkeep

# Regenerated by the notebook (~120 MB)
data/processed/*
!data/processed/.gitkeep

# AniList collection output: usernames, AniList user IDs and full lists.
# The anonymised copy, data/raw/anilist_anonymised/, is committed.
data/raw/anilist/*
!data/raw/anilist/.gitkeep
data/raw/anilist_test/

# Synopsis text (MyAnimeList's copyrighted text); only the embeddings built from it are committed
data/raw/anilist_anonymised/anime_synopses.csv

# Local notes and the original coursework report (personal details)
chat_summary.txt
*.pdf

# Python / Jupyter
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
